generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Commodity {
  id         Int      @id @default(autoincrement())
  category   String?
  name       String
  price      Float?
  region     String   @default("NCR")
  sourceDate DateTime
  createdAt  DateTime @default(now())

  @@unique([name, region, sourceDate])
  @@index([name, sourceDate])
}

model Recipe {
  id           Int                 @id @default(autoincrement())
  title        String
  url          String              @unique
  imageUrl     String?
  description  String?             @db.Text
  servings     Int?
  prepTime     Int?
  cookTime     Int?
  sourceSite   String              @default("PanlasangPinoy")
  scrapedAt    DateTime            @default(now())
  /// From the page's schema.org Recipe JSON-LD: recipeCategory and recipeCuisine, ", "-joined ("Main Course, Soup").
  course       String?
  cuisine      String?
  /// recipeYield as written ("4 people", "24 pieces").
  yieldText    String?
  /// Panlasang Pinoy's own per-serving nutrition (WPRM calculator); per whole recipe when the page gives no yield.
  refNutrition Json?
  /// When the structured data was last read from the page (null: not yet).
  structuredAt DateTime?
  /// Recipes added since 2026-10-27 keep only these short method phrases ("deep fry. discard the
  /// marinade. oven"), not the author's steps; the site links to the original page for the method.
  methodNotes  String?             @db.Text
  ingredients  RecipeIngredient[]
  instructions RecipeInstruction[]
}

model RecipeIngredient {
  id       Int    @id @default(autoincrement())
  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawText  String
  name     String
  amount   String?
  unit     String?
  /// Ingredient group heading on the page ("Marinade ingredients", "For dredging").
  groupName String?

  @@index([recipeId])
}

model RecipeInstruction {
  id         Int    @id @default(autoincrement())
  recipeId   Int
  recipe     Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepNumber Int
  text       String @db.Text

  @@unique([recipeId, stepNumber])
}

model NutritionFact {
  id            Int      @id @default(autoincrement())
  foodName      String
  foodCode      String   @unique
  calories      Float?
  protein       Float?
  fat           Float?
  carbohydrates Float?
  fiber         Float?
  calcium       Float?
  iron          Float?
  vitaminA      Float?
  vitaminB1     Float?
  vitaminB2     Float?
  vitaminC      Float?
  sodium        Float?
  /// Alternate/common (mostly Filipino) names from the FNRI directory, e.g. "Bigas, maputi, sinaing".
  altNames       String?
  scientificName String?
  /// Edible portion as purchased, in percent (FNRI values are per 100 g E.P.).
  ediblePortion  Float?
  sourceUrl     String?
  source        String   @default("FNRI")
  scrapedAt     DateTime @default(now())
}

model StoreProduct {
  id         Int      @id @default(autoincrement())
  sku        String
  name       String
  category   String?
  uom        String?
  price      Float?
  imageUrl   String?
  url        String?
  source     String   @default("SMMarkets")
  sourceDate DateTime
  createdAt  DateTime @default(now())

  @@unique([sku, sourceDate])
  @@index([sku, sourceDate])
}

model ScrapingLog {
  id            Int       @id @default(autoincrement())
  type          String
  status        String
  itemsScraped  Int       @default(0)
  message       String?   @db.Text
  cursor        String?   @db.Text
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
}

/// PSA OpenSTAT monthly retail (palengke) prices, Metro Manila. One row per commodity per month.
model PsaPrice {
  id        Int      @id @default(autoincrement())
  /// PSA commodity text exactly as published ("FRESH SHELLS, TAHONG, 1 KG").
  commodity String
  /// PSA table it came from ("Fish", "Leafy Vegetables").
  category  String?
  /// "kg" or "piece", from the commodity text.
  unit      String
  price     Float
  /// First day of the month the price is for.
  period    DateTime
  region    String   @default("NCR")
  createdAt DateTime @default(now())

  @@unique([commodity, region, period])
  @@index([period])
}
